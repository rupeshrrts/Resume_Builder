# Template for the APP_ENV secret in GitHub (Settings → Secrets and variables → Actions).
# Paste this whole block there with your values filled in. Each deploy writes it to deploy/.env
# on the server. Never commit real values to the repository.

# Your domain, without https:// or www.
DOMAIN=yourdomain.in

# Supabase → Connect → "Session pooler" connection string (port 5432), password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Your own secret for resetting a forgotten admin password (letters only, 12 or more).
ADMIN_SETUP_CODE=

# AI: set at least one (Gemini and Groq have free plans). Delete the lines you don't use.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional, see DEPLOY.md → Environment variables for the full list:
# ADMIN_EMAILS=you@example.com
# GOOGLE_SITE_VERIFICATION=
# RESEND_API_KEY=
# MAIL_FROM=Free ATS Resume <no-reply@yourdomain.in>
