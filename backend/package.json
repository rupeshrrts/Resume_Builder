    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@react-pdf/renderer": "4.9.0",
    "@resume/shared": "*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dictionary-en": "4.0.0",
    "docx": "9.14.0",
    "express": "5.3.0",
    "fontkit": "2.0.4",
