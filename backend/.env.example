# Copy to backend/.env for local development. On a host, set these as environment variables.
# Never commit real values.

# Local port. On a hosting platform PORT is used instead (set by the platform).
API_PORT=4000
# Public URL(s) of the website, comma-separated. Required in production (https://…).
FRONTEND_ORIGIN=http://localhost:3000
# Shared secret between the website's /api proxy and this API (same value on both).
# Lets the API see visitors' real IPs for rate limiting. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# PROXY_SECRET=

# ---- Database ----
# Supabase: Project → Connect → "Session pooler" connection string (works over IPv4), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase's CA certificate (Project Settings → Database → SSL Configuration → Download certificate),
# as a file path, the PEM text, or the PEM base64-encoded. Verifies the server over TLS.
# Supabase's certificate is built in (backend/certs). Only for other providers:
# DATABASE_SSL_CA=./their-ca.crt
# DATABASE_SSL=no-verify   # encrypt without verifying (not recommended); "off" disables TLS
# PG_POOL_MAX=5            # keep within your plan's pooler limit
# MIGRATE_ON_START=true    # set false if you run database/schema.sql yourself
#
# Without DATABASE_URL (development only), an embedded PostgreSQL (PGlite) is stored here.
# Keep it OUTSIDE OneDrive/Dropbox-synced folders.
PGLITE_DIR=./.data/pglite

# ---- AI (optional) ----
# Without a key, AI features show as unavailable; everything else works.
# Set at least one. With several, they're tried in this order and the app moves on to the next
# when one is busy or out of credit: Claude, OpenAI, Gemini, Groq, NVIDIA.
#
# OpenAI (paid, needs credit): platform.openai.com → API keys → Create new secret key (sk-...)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
#
# Google Gemini (free plan): aistudio.google.com → Get API key → Create API key
# Note: on the free plan Google may use what's sent to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# Groq (free plan): console.groq.com → API Keys → Create API Key (gsk_...)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
#
# NVIDIA (free, for development): build.nvidia.com/deepseek-ai/deepseek-v4.1-flash → Generate API Key (nvapi-...)
# The model must have a "Free Endpoint"; if NVIDIA retires it, set NVIDIA_MODEL to another one.
NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
#
# Claude (paid, best quality): console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# AI_FALLBACKS=on
#
# AI_PROVIDER=gemini       # try this one first: anthropic | openai | gemini | groq | nvidia
# AI_MAX_TOKENS=8192       # override the reply-length limit for OpenAI/Gemini/Groq/NVIDIA

# ---- Admin dashboard (no setup needed) ----
# The owner's account. On start, until it's activated, the server logs an "admin_setup_code":
# sign in with this email, open Account and enter the code.
# ADMIN_EMAILS=rupeshsinghsuntech@gmail.com
# ADMIN_SETUP_CODE=         # optional: a fixed code instead of a new random one each start
# ANALYTICS=on              # visit counting is on in production; "on" also counts locally, "off" disables it

# ---- Email (optional) ----
# Not needed: forgotten passwords use the recovery code from sign-up, and the admin can make reset links.
# With one of these, verification and reset emails are sent too (both have free plans):
# RESEND_API_KEY=           # resend.com
# BREVO_API_KEY=            # brevo.com
# MAIL_FROM=Free ATS Resume <no-reply@reesume.in>
# APP_URL=https://reesume.in   # link address in emails (default: first FRONTEND_ORIGIN)

# ---- Other ----
# NODE_ENV=production      # enables Secure cookies and the startup configuration checks
# MAX_UPLOAD_BYTES=5242880
# TRUST_PROXY=1            # number of proxies in front of the API (fallback IP source if PROXY_SECRET isn't set)
# COOKIE_SECURE=true       # force Secure cookies on/off (default: on when NODE_ENV=production)
