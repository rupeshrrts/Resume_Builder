# Copy to frontend/.env.local for local development. On a host, set these as environment variables.
# Where this server reaches the API (read at runtime; "host:port" is treated as http://host:port).
BACKEND_URL=http://localhost:4000
# Same value as the API's PROXY_SECRET, so the API can trust the visitor IP this proxy passes on.
# PROXY_SECRET=
# Public address used in the sitemap, robots.txt and link previews (default https://freeatsresume.in).
# SITE_URL=https://freeatsresume.in
# Google Search Console → "HTML tag" verification code (only the content="…" value).
# GOOGLE_SITE_VERIFICATION=
